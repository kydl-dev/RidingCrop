{
  "name": "selftest",
  "description": "RidingCrop's own in-game checks pass (config bound, bundle loaded, crops and skill registered)",
  "timeout": 60,
  "steps": [
    {
      "do": "hook",
      "name": "ridingcrop.arena",
      "contains": "arena at",
      "label": "start on the arena spot"
    },
    {
      "do": "wait",
      "seconds": 6
    },
    {
      "do": "hook",
      "name": "ridingcrop.selftest",
      "notContains": "FAIL",
      "contains": "PASS"
    }
  ],
  "asserts": [
    {
      "check": "noErrors",
      "source": "RidingCrop"
    }
  ]
}
