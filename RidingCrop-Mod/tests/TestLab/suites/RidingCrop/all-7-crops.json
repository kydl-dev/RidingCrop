{
  "name": "all-7-crops",
  "description": "All seven crops exist, have a recipe, are blunt-only with a bleed and max quality 4",
  "timeout": 60,
  "steps": [
    {
      "do": "hook",
      "name": "ridingcrop.arena",
      "contains": "arena at",
      "label": "start on the arena spot"
    },
    {
      "do": "hook",
      "name": "ridingcrop.crops",
      "expect": 7
    },
    {
      "do": "hook",
      "name": "ridingcrop.hasRecipe",
      "args": {
        "prefab": "RidingCrop"
      },
      "expect": true,
      "label": "RidingCrop recipe"
    },
    {
      "do": "hook",
      "name": "ridingcrop.maxQuality",
      "args": {
        "prefab": "RidingCrop"
      },
      "expect": 4,
      "label": "RidingCrop max quality"
    },
    {
      "do": "hook",
      "name": "ridingcrop.hasRecipe",
      "args": {
        "prefab": "RidingCrop_V1"
      },
      "expect": true,
      "label": "RidingCrop_V1 recipe"
    },
    {
      "do": "hook",
