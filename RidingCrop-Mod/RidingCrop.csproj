<Project Sdk="Microsoft.NET.Sdk">
  <!--
    RidingCrop mod. Everything shared by the user's mods (references from E:\Projects\Valheim\Claude\ref, net48, no debug symbols,
    the shared code Kydl.Common / Kydl.Ui, copy to Assets + build, embedded bundle) comes from Claude\shared\Kydl.Mod.props / .targets.
    Add here only what is special about this mod (an extra reference: put the DLL into Claude\ref and add a line below).
    Build: dotnet build "RidingCrop-Mod\RidingCrop.csproj" -c Release
  -->
  <Import Project="..\..\Claude\shared\Kydl.Mod.props" />

  <PropertyGroup>
    <AssemblyName>RidingCrop</AssemblyName>
    <RootNamespace>RidingCrop</RootNamespace>
    <PackageId>RidingCrop</PackageId>
    <!-- AssetBundle built by the Unity project (Valheim > Build AssetBundles); embedded into the DLL when Assets\ridingcrop exists -->
    <BundleName>ridingcrop</BundleName>
    <!-- spec layout (MIGRATION_DECISIONS A8): the DLL goes to assets\ only, no build\ folder -->
    <KydlBuildFolder>false</KydlBuildFolder>
  </PropertyGroup>

  <ItemGroup>
    <!-- tests\ (NUnit + TestLab suites), docs\ and release\ live inside this folder but are never part of the mod (spec 3: excluded from the release) -->
    <Compile Remove="tests\**;docs\**;release\**" />
    <None Remove="tests\**;docs\**;release\**" />
    <EmbeddedResource Remove="tests\**;docs\**;release\**" />
  </ItemGroup>


  <ItemGroup>
    <!-- AudioClip.GetData / SetData have Span overloads in the game's Unity: the compiler needs the game's own mscorlib to resolve them -->
    <Reference Include="mscorlib"><HintPath>$(ValheimRefs)\mscorlib.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <Import Project="..\..\Claude\shared\Kydl.Mod.targets" />
</Project>
